{
  "schemaVersion": 1,
  "id": "heracles",
  "version": "${version}",
  "name": "Heracles",
  "description": "Heracles is a comprehensive questing mod that allows pack makers to create tree style quests that can be distributed via the config folder for users to play and complete. Eternia fork source: https://github.com/jtsus/Heracles",
  "authors": [
    "ThatGravyBoat",
    "Justin"
  ],
  "contact": {
    "homepage": "https://github.com/jtsus/Heracles",
    "sources": "https://github.com/jtsus/Heracles",
    "issues": "https://github.com/jtsus/Heracles/issues"
  },
  "icon": "assets/heracles/icon.png",
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "earth.terrarium.heracles.fabric.HeraclesFabric::init"
    ],
    "client": [
      "earth.terrarium.heracles.client.HeraclesClient::init",
      "earth.terrarium.heracles.fabric.HeraclesFabricClient"
    ],
    "rei_client": [
      "earth.terrarium.heracles.client.compat.rei.HeraclesReiClientPlugin"
    ],
    "jei_mod_plugin": [
      "earth.terrarium.heracles.client.compat.jei.HeraclesJeiModPlugin"
    ]
  },
  "mixins": [
    "heracles.mixins.json",
    "heracles-common.mixins.json"
  ],
  "depends": {
    "fabric": ">=0.14.19",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "resourcefullib": ">=3.0.11",
    "java": ">=21"
  }
}
